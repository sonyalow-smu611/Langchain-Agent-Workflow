# Shared environment variables for the whole repo
# (study_langchain/, langchain_fundamentals/, vibecoder/)
# Copy this file to .env in the repo root and fill in real values.

# Required by langchain-openai (ChatOpenAI, OpenAIEmbeddings) across all three projects
OPENAI_API_KEY=

# Optional override for vibecoder/src/agents/base.py (defaults to gpt-4.1-mini)
MODEL_NAME=
